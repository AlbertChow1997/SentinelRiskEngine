# Copy to `.env` for local development: `cp .env.example .env`
# `.env` is git-ignored. Never commit real secrets, tokens or AWS account IDs.
# Staging values live in AWS SSM Parameter Store, not here.

# ----- Local PostgreSQL (docker compose only; never reuse elsewhere) -----
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-local-only

# ----- LLM insight service -----
# "stub" = deterministic StubProvider (no network, no cost). "bedrock" needs AWS credentials.
LLM_PROVIDER=stub
LLM_DAILY_BUDGET_USD=1.00

# ----- Cognito (shared dev/staging user pool; values come from Terraform outputs) -----
COGNITO_ISSUER_URI=
COGNITO_CLIENT_ID=

# ----- Frontend -----
VITE_USE_MOCKS=true
VITE_DEMO_MERCHANT_KEY=
